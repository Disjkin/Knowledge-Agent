# ──────────────────────────────────────────
# 服务
# ──────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ──────────────────────────────────────────
# 模型提供者: openai | anthropic
#   openai     -> 含 DeepSeek/通义千问/智谱/OpenAI 等所有兼容服务
#   anthropic  -> Claude
# ──────────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI 兼容接口（LLM_PROVIDER=openai 时生效）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Anthropic Claude（LLM_PROVIDER=anthropic 时生效）
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ──────────────────────────────────────────
# 嵌入模型: local | openai
#   local  -> 本地 sentence-transformers 中文模型（无需联网）
#   openai -> 用 OPENAI_BASE_URL 的嵌入接口
# ──────────────────────────────────────────
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # openai 嵌入时使用

# ──────────────────────────────────────────
# RAG 参数
# ──────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_K=5

# ──────────────────────────────────────────
# 网搜兜底
# ──────────────────────────────────────────
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily          # tavily | duckduckgo
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_PROXY=                    # 代理地址，如 http://127.0.0.1:7897（国内直连不可用时填写）
RELEVANCE_THRESHOLD=0.3             # 本地检索最高分低于此值 -> 走网搜

# ──────────────────────────────────────────
# 链路追踪
# ──────────────────────────────────────────
TRACE_ENABLED=true
TRACE_DIR=logs/traces
TRACE_MAX_FIELD_LEN=2000
